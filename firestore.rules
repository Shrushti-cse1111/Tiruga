rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /destinations/{id} {
      allow read: if true;
      allow write: if false;
      match /attractions/{aid} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /phrases/{id}   { allow read: if true; allow write: if false; }
    match /transport/{id} { allow read: if true; allow write: if false; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['name','email','photoURL','language','travellerType',
              'budget','interests','travelStyle','days','createdAt','updatedAt'])
        && (!('interests' in request.resource.data) || request.resource.data.interests is list)
        && (!('language' in request.resource.data) || request.resource.data.language in ['en','kn']);
      allow delete: if false;

      match /trips/{tripId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['title','destination','destinationId','totalDays','estimatedBudget',
                'preferences','days','meta','schemaVersion','createdAt','updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.totalDays is int
          && request.resource.data.totalDays >= 1
          && request.resource.data.totalDays <= 7
          && request.resource.data.estimatedBudget is number
          && request.resource.data.days is list
          && request.resource.data.days.size() <= 7;
      }

      match /savedPlaces/{savedId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['destinationId','attractionId','createdAt']);
      }
    }
  }
}
